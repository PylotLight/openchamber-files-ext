{
  "name": "files-nav",
  "version": "0.3.0",
  "private": true,
  "description": "Files panel extension for OpenChamber: project/home file tree with breadcrumbs, search, a multi-tab CodeMirror editor, and a form view for opencode config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PylotLight/openchamber-files-ext.git"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "files-nav",
        "name": "Files",
        "icon": "folder",
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": [
        "files"
      ],
      "filesystem": [
        "~/**"
      ]
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@openchamber/sdk": "^1.24.2",
    "ajv": "^8",
    "codemirror": "^6.0.2",
    "jsonc-parser": "^3.3.1"
  },
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "validate": "bun scripts/validate-manifest.mjs",
    "test": "bun test",
    "sync:schema": "bun scripts/sync-schema.ts",
    "sync:models": "bun scripts/sync-models.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5"
  }
}
